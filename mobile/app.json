{
  "expo": {
    "name": "OfficinAI",
    "slug": "officinai",
    "scheme": "officinai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a5f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.officinai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.officinai.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OfficinAI ha bisogno di accedere alla fotocamera per scattare foto dei veicoli."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1e3a5f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OfficinAI ha bisogno di accedere alle foto per allegare immagini ai lavori."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
